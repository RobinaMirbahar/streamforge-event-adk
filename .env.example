# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Eventarc + Cloud Storage Trigger Bucket
STREAMFORGE_INBOX_BUCKET=streamforge-launch-inbox

# Runtime Mode: "local_ollama" | "cloud_run_vllm" | "vertex_ai"
STREAMFORGE_RUNTIME_MODE=local_ollama
STREAMFORGE_MODEL_NAME=ollama_chat/gemma3:12b
VLLM_API_BASE=http://localhost:8000/v1

# Cloud Firestore Collections
FIRESTORE_MANIFESTS_COLLECTION=launch_manifests
FIRESTORE_CLOUDEVENT_LEDGER=cloudevent_dedup_ledger
